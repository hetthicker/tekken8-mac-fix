+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -521,6 +521,7 @@ struct amd64_thread_data
     DWORD                 fs;            /* 0338 WOW TEB selector */
     DWORD                 mxcsr;         /* 033c Unix-side mxcsr register */
     char                  syscall_dispatch; /* 0340 */
+    void                 *pthread_qos;   /* 0348 macOS: unix-side value of the TSD slot under gs:0x20 */
 };
 
 C_ASSERT( sizeof(struct amd64_thread_data) <= sizeof(((struct teb_data *)0)->cpu_data) );
@@ -530,6 +531,7 @@ C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, ins
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, fs ) == 0x338 );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, mxcsr ) == 0x33c );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, syscall_dispatch ) == 0x340 );
+C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, pthread_qos ) == 0x348 );
 
 static inline struct amd64_thread_data *amd64_thread_data( struct thread_data *data )
 {
@@ -799,6 +801,16 @@ static inline struct thread_data *init_handler( void *sigcontext )
 #elif defined __APPLE__
     _thread_set_tsd_base( (uint64_t)amd64_data->pthread_teb );
 
+    /* PE code runs with gsbase on the pthread TSD, where gs:0x20 is both the
+     * Windows fiber pointer and the macOS QoS slot. If we interrupted PE code,
+     * the slot holds the fiber pointer; give macOS its value back before any
+     * libsystem code in the handler reads it. TEB->Tib.FiberData stays the
+     * authoritative copy of the PE value (kernelbase writes both). */
+    if (amd64_data->pthread_qos &&
+        !is_inside_signal_stack( data, (void *)RSP_sig((ucontext_t *)sigcontext) ) &&
+        !is_inside_syscall( data, RSP_sig((ucontext_t *)sigcontext) ))
+        ((void **)amd64_data->pthread_teb)[4] = amd64_data->pthread_qos;
+
     /* When in a syscall, CS will be the kernel's selector (0x07, SYSCALL_CS in xnu source)
      * instead of the user selector (cs64_sel: 0x2b, USER64_CS).
      * Fix up sigcontext so later code can compare it to cs64_sel.
@@ -1706,6 +1718,15 @@ __ASM_GLOBAL_FUNC( call_user_mode_callback,
                    "jz 1f\n\t"
                    "movw %ax,%fs\n"
                    "1:\n\t"
+#elif defined __APPLE__
+                   /* entering PE on a fiber thread: stash the macOS QoS slot, expose the fiber pointer at gs:0x20 */
+                   "testb $0x4,0x17ee(%r13)\n\t" /* NtCurrentTeb()->HasFiberData */
+                   "jz 1f\n\t"
+                   "movq %gs:0x20,%rax\n\t"
+                   "movq %rax,0x348(%r13)\n\t" /* amd64_thread_data()->pthread_qos */
+                   "movq 0x20(%r13),%rax\n\t"  /* NtCurrentTeb()->Tib.FiberData */
+                   "movq %rax,%gs:0x20\n"
+                   "1:\n\t"
 #endif
                    "movq 0x330(%r13),%r10\n\t" /* amd64_thread_data()->instrumentation_callback */
                    "movq (%r10),%r10\n\t"
@@ -3337,7 +3358,13 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    "xorl %esi,%esi\n\t"
                    "movl $0x3000003,%eax\n\t"      /* _thread_set_tsd_base */
                    "syscall\n\t"
-                   "leaq -0x98(%rbp),%rcx\n"
+                   /* entering unix: if gs:0x20 holds a fiber pointer, give the macOS QoS slot back its value */
+                   "movq 0x348(%r13),%rsi\n\t"     /* amd64_thread_data()->pthread_qos */
+                   "testq %rsi,%rsi\n\t"
+                   "jz 9f\n\t"
+                   "movq %rsi,%gs:0x20\n\t"
+                   "movq $0,0x348(%r13)\n"
+                   "9:\tleaq -0x98(%rbp),%rcx\n"
 #endif
                    "ldmxcsr 0x33c(%r13)\n\t"       /* amd64_thread_data()->mxcsr */
                    "movl 0xb0(%rcx),%eax\n\t"      /* frame->syscall_id */
@@ -3377,6 +3404,16 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    /* push rbp-based kernel stack cfi */
                    __ASM_CFI(".cfi_remember_state\n\t")
                    __ASM_CFI_CFA_IS_AT2(rcx, 0xa8, 0x01) /* frame->syscall_cfa */
+#ifdef __APPLE__
+                   /* leaving unix on a fiber thread: stash the macOS QoS slot, expose the fiber pointer at gs:0x20 */
+                   "testb $0x4,0x17ee(%r13)\n\t"   /* NtCurrentTeb()->HasFiberData */
+                   "jz 8f\n\t"
+                   "movq %gs:0x20,%rdx\n\t"
+                   "movq %rdx,0x348(%r13)\n\t"     /* amd64_thread_data()->pthread_qos */
+                   "movq 0x20(%r13),%rdx\n\t"      /* NtCurrentTeb()->Tib.FiberData */
+                   "movq %rdx,%gs:0x20\n"
+                   "8:\n\t"
+#endif
                    "leaq 0x70(%rcx),%rsp\n\t"      /* %rsp > frame means no longer inside syscall */
 #if defined(__linux__) || defined(__FreeBSD__)
                    "movb $1,0x340(%r13)\n\t"       /* amd64_thread_data()->syscall_dispatch */
@@ -3659,6 +3696,13 @@ __ASM_GLOBAL_FUNC( __wine_unix_call_dispatcher,
                    "xorl %esi,%esi\n\t"
                    "movl $0x3000003,%eax\n\t"      /* _thread_set_tsd_base */
                    "syscall\n\t"
+                   /* entering unix: if gs:0x20 holds a fiber pointer, give the macOS QoS slot back its value */
+                   "movq 0x348(%r13),%rsi\n\t"     /* amd64_thread_data()->pthread_qos */
+                   "testq %rsi,%rsi\n\t"
+                   "jz 9f\n\t"
+                   "movq %rsi,%gs:0x20\n\t"
+                   "movq $0,0x348(%r13)\n"

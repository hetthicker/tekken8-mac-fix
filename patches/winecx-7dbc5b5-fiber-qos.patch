diff --git a/dlls/kernelbase/thread.c b/dlls/kernelbase/thread.c
index 58b30fe..90071f4 100644
--- a/dlls/kernelbase/thread.c
+++ b/dlls/kernelbase/thread.c
@@ -1144,6 +1144,33 @@ LPVOID WINAPI DECLSPEC_HOTPATCH CreateFiberEx( SIZE_T stack_commit, SIZE_T stack
 }
 
 
+static inline void set_current_fiber( void *fiber )
+{
+#ifdef __x86_64__
+    /* Applications read GetCurrentFiber() straight off gs:0x20. On macOS PE code
+     * usually runs with gsbase on the pthread TSD rather than the TEB, and that
+     * slot is the macOS QoS value. Park the QoS value where ntdll's syscall and
+     * unix call dispatchers put it back on the way into unix code (see
+     * amd64_thread_data::pthread_qos), then expose the fiber pointer. */
+    void **pthread_qos = (void **)((char *)NtCurrentTeb() + 0x348);
+    void *gs0, *slot;
+
+    __asm__ __volatile__( "movq %%gs:0x0,%0" : "=r" (gs0) );
+    if (gs0 != NtCurrentTeb()->Tib.ExceptionList)  /* gsbase is not the TEB */
+    {
+        if (!*pthread_qos)
+        {
+            __asm__ __volatile__( "movq %%gs:0x20,%0" : "=r" (slot) );
+            if (fiber) *pthread_qos = slot;
+        }
+        if (fiber || *pthread_qos)
+            __asm__ __volatile__( "movq %0,%%gs:0x20" :: "r" (fiber) : "memory" );
+    }
+#endif
+    NtCurrentTeb()->Tib.FiberData = fiber;
+}
+
+
 /***********************************************************************
  *           ConvertFiberToThread   (kernelbase.@)
  */
@@ -1157,7 +1184,7 @@ BOOL WINAPI DECLSPEC_HOTPATCH ConvertFiberToThread(void)
         return FALSE;
     }
     relocate_thread_actctx_stack( &NtCurrentTeb()->ActivationContextStack );
-    NtCurrentTeb()->Tib.FiberData = NULL;
+    set_current_fiber( NULL );
     NtCurrentTeb()->HasFiberData = FALSE;
     HeapFree( GetProcessHeap(), 0, fiber );
     return TRUE;
@@ -1219,7 +1246,7 @@ LPVOID WINAPI DECLSPEC_HOTPATCH ConvertThreadToFiberEx( LPVOID param, DWORD flag
     fiber->flags            = flags;
     fiber->fls_slots        = NtCurrentTeb()->FlsSlots;
     relocate_thread_actctx_stack( &fiber->actctx.stack_space );
-    NtCurrentTeb()->Tib.FiberData = fiber;
+    set_current_fiber( fiber );
     NtCurrentTeb()->HasFiberData = TRUE;
     return fiber;
 }
@@ -1270,7 +1297,7 @@ void WINAPI DECLSPEC_HOTPATCH SwitchToFiber( LPVOID fiber )
     /* stack_allocation and stack_base never change */
 
     /* FIXME: should save floating point context if requested in fiber->flags */
-    NtCurrentTeb()->Tib.FiberData     = new_fiber;
+    set_current_fiber( new_fiber );
     NtCurrentTeb()->Tib.ExceptionList = new_fiber->except;
     NtCurrentTeb()->Tib.StackBase     = new_fiber->stack_base;
     NtCurrentTeb()->Tib.StackLimit    = new_fiber->stack_limit;
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 2b1338c..3e85624 100644
